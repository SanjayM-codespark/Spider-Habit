# SMTP used to email password-reset codes. If SMTP_HOST is empty (development
# only) the code is printed in the server console instead of being emailed.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASS=
SMTP_FROM="Spider Habit <no-reply@example.com>"
